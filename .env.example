# CommitPay — copy to `.env.local` (never commit real values)
# PayPal Developer: https://developer.paypal.com/dashboard/

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production example: https://commitpay.vercel.app

# PayPal REST (Sandbox first)
# Use a US Business sandbox REST app (placeholders only here)
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook ID from PayPal dashboard after you register the URL
PAYPAL_WEBHOOK_ID=

# Optional: live credentials only after sandbox demo works (leave blank for hackathon)
# PAYPAL_LIVE_CLIENT_ID=
# PAYPAL_LIVE_CLIENT_SECRET=

# AI judge (pick one free tier; leave unused keys blank)
GROQ_API_KEY=
# or
GEMINI_API_KEY=

# Database (libSQL via @libsql/client)
# Local dev: plain SQLite file, no token needed
DATABASE_URL=file:./commitpay.db
# Production (Vercel): Turso free DB — takes precedence over DATABASE_URL when set
# TURSO_DATABASE_URL=libsql://commitpay-<org>.turso.io
# TURSO_AUTH_TOKEN=

# Auth / session (generate a long random string)
SESSION_SECRET=

# Escape-hatch / anti-cheat toggles (defaults on)
FEATURE_ANTI_CHEAT=1
FEATURE_ESCAPE_HATCH=1
